{
  "name": "agent-ctx",
  "version": "1.0.1",
  "description": "CLI tool to initialize and manage AI agent context for your projects",
  "keywords": [
    "ai",
    "agent",
    "context",
    "cursor",
    "antigravity",
    "claude",
    "copilot",
    "cline",
    "cli"
  ],
  "author": "avicdro",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-ctx": "./dist/bin/agent-ctx.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "figlet": "^1.10.0",
    "inquirer": "^9.2.23",
    "ora": "^8.0.1",
    "tar": "^7.5.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@types/figlet": "^1.7.0",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.1.0",
    "@types/tar": "^6.1.13",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/avicdro/agent-ctx"
  },
  "bugs": {
    "url": "https://github.com/avicdro/agent-ctx/issues"
  },
  "homepage": "https://github.com/avicdro/agent-ctx#readme"
}
